# Copy file này thành ".env" (cùng thư mục), rồi điền giá trị thật.
# ".env" đã có trong .gitignore từ Tuần 1 — không commit lên Git.
# Đây là mật khẩu MySQL cho môi trường DEV cục bộ, không phải secret thật (VNPay key, JWT
# signing key... sẽ xử lý kỹ hơn khi tới Tuần 5+) — nhưng vẫn tách khỏi docker-compose.yml
# (file có commit) để không có chuỗi nào giống mật khẩu nằm trong lịch sử Git, tránh gitleaks
# (Bước 7) báo động giả và giữ thói quen đúng ngay từ đầu.

MYSQL_ROOT_PASSWORD=changeme_local_dev

# --- Bước 2 Tuần 5: xác thực ---
# Khóa ký JWT, tối thiểu 32 ký tự. Để trống thì backend tự sinh khóa ngẫu nhiên mỗi lần khởi
# động (đăng nhập lại sau mỗi lần khởi động lại). Sinh một khóa trong PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
# Tài khoản Quản trị viên đầu tiên, backend tạo lúc khởi động nếu email chưa có tài khoản.
ADMIN_EMAIL=
ADMIN_PASSWORD=
