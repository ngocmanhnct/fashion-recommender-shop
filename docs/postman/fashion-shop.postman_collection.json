{
  "info": {
    "name": "Fashion Shop API (Tuần 6)",
    "description": "Bộ request thử API backend: đăng nhập, danh mục, thương hiệu, sản phẩm, biến thể.\n\nCách dùng: điền biến adminEmail và adminPassword ở tab Variables của collection (giống ADMIN_EMAIL, ADMIN_PASSWORD trong .env), chạy '1. Xác thực > Đăng nhập admin' trước. Token tự lưu vào biến token và mọi request khác tự gửi kèm. Các request tạo mới tự lưu id vừa tạo (categoryId, brandId, productId, variantId) cho request sau dùng.\n\nToken hết hạn sau 24 giờ, và backend tạo khóa mới mỗi lần khởi động lại nếu JWT_SECRET để trống, nên khởi động lại backend thì đăng nhập lại.\n\nCác nhóm API: 1. Xác thực, 2. Công khai, 3. Khách hàng, 4. Admin (chia nhỏ theo đối tượng quản lý). API mới được thêm vào đúng nhóm theo quyền truy cập.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "brandId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "variantId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Xác thực (Auth)",
      "item": [
        {
          "name": "Đăng ký khách hàng",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"khach1@example.com\",\n  \"password\": \"matkhau123\",\n  \"fullName\": \"Nguyễn Văn A\",\n  \"gender\": \"MALE\",\n  \"birthdate\": \"2000-05-20\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Trả 201. gender: MALE, FEMALE hoặc OTHER (không bắt buộc). Mật khẩu 8 đến 72 ký tự, có ít nhất 1 chữ cái và 1 chữ số."
          }
        },
        {
          "name": "Đăng nhập khách hàng",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"khach1@example.com\",\n  \"password\": \"matkhau123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Lưu token của khách. Gọi API admin với token này sẽ bị 403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.accessToken) { pm.collectionVariables.set('token', j.accessToken); console.log('Đã lưu token, role =', j.account && j.account.role); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập admin",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Dùng biến adminEmail, adminPassword. Sai 5 lần trong 15 phút thì bị khóa 15 phút (429).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Đăng nhập thành công', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.accessToken) { pm.collectionVariables.set('token', j.accessToken); console.log('Đã lưu token, role =', j.account && j.account.role); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Tài khoản hiện tại (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ],
      "description": "Đăng ký, đăng nhập, xem tài khoản hiện tại. Đăng nhập xong token tự lưu vào biến token."
    },
    {
      "name": "2. Công khai (không cần đăng nhập)",
      "item": [
        {
          "name": "Danh sách danh mục",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Danh sách thương hiệu",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/brands",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "brands"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ],
      "auth": {
        "type": "noauth"
      },
      "description": "API ai cũng gọi được, không gửi token."
    },
    {
      "name": "3. Khách hàng (cần token tài khoản khách)",
      "description": "API cho người dùng đã đăng nhập với vai trò khách hàng: giỏ hàng, đặt hàng, khảo sát, đánh giá... Chưa có API nào (sẽ thêm từ Tuần 6).",
      "item": []
    },
    {
      "name": "4. Admin (cần token ADMIN)",
      "description": "API quản trị, chỉ tài khoản ADMIN gọi được. Token khách sẽ bị 403, không có token sẽ bị 401. Chạy '1. Xác thực > Đăng nhập admin' trước.",
      "item": [
        {
          "name": "Danh mục",
          "item": [
            {
              "name": "Thêm danh mục",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/categories",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "categories"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Giày dép\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Trả 201. Tên trùng (không phân biệt hoa thường, dấu) trả 409."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code < 300) { pm.collectionVariables.set('categoryId', pm.response.json().id); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Đổi tên danh mục",
              "request": {
                "method": "PUT",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/categories/{{categoryId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "categories",
                    "{{categoryId}}"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Giày dép nam\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Xóa danh mục",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/categories/{{categoryId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "categories",
                    "{{categoryId}}"
                  ]
                },
                "description": "Trả 204. Còn sản phẩm (kể cả đã ngừng bán) thì trả 409."
              }
            }
          ]
        },
        {
          "name": "Thương hiệu",
          "item": [
            {
              "name": "Thêm thương hiệu",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/brands",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "brands"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Biti's\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code < 300) { pm.collectionVariables.set('brandId', pm.response.json().id); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Đổi tên thương hiệu",
              "request": {
                "method": "PUT",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/brands/{{brandId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "brands",
                    "{{brandId}}"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Biti's Hunter\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Xóa thương hiệu",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/brands/{{brandId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "brands",
                    "{{brandId}}"
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Sản phẩm",
          "item": [
            {
              "name": "Thêm sản phẩm",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/products",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "products"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Giày chạy bộ\",\n  \"description\": \"Đế êm, nhẹ\",\n  \"categoryId\": {{categoryId}},\n  \"brandId\": {{brandId}},\n  \"variationName1\": \"Màu sắc\",\n  \"variationName2\": \"Kích cỡ\",\n  \"imageUrls\": [\n    \"https://example.com/giay-1.jpg\"\n  ],\n  \"variants\": [\n    {\n      \"option1Value\": \"Đen\",\n      \"option2Value\": \"42\",\n      \"price\": 890000,\n      \"stock\": 10,\n      \"skuCode\": \"GCB-DEN-42\"\n    },\n    {\n      \"option1Value\": \"Đen\",\n      \"option2Value\": \"43\",\n      \"price\": 890000,\n      \"stock\": 6,\n      \"skuCode\": null\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Sản phẩm có tối đa 2 tầng phân loại do admin đặt tên (variationName1, variationName2, vd Màu sắc, Kích cỡ). Mỗi biến thể là 1 tổ hợp giá trị: option1Value cho tầng 1, option2Value cho tầng 2; tầng không dùng thì để null. Không có tầng nào thì sản phẩm có đúng 1 biến thể (xem request kế tiếp). Không được có 2 biến thể trùng tổ hợp giá trị (không phân biệt hoa thường và dấu: \"Đen\" trùng \"den\"). skuCode không trùng trong toàn hệ thống. Lỗi 400 nếu biến thể thiếu hoặc thừa giá trị so với số tầng."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code < 300) { pm.collectionVariables.set('productId', pm.response.json().id); }",
                      "if (pm.response.code < 300) { pm.collectionVariables.set('variantId', pm.response.json().variants[0].id); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Thêm sản phẩm không có phân loại",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/products",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "products"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Sổ tay A5\",\n  \"description\": \"Bìa cứng, 200 trang\",\n  \"categoryId\": {{categoryId}},\n  \"brandId\": null,\n  \"variationName1\": null,\n  \"variationName2\": null,\n  \"imageUrls\": [],\n  \"variants\": [\n    {\n      \"option1Value\": null,\n      \"option2Value\": null,\n      \"price\": 45000,\n      \"stock\": 20,\n      \"skuCode\": null\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Để trống variationName1, variationName2: sản phẩm có đúng 1 biến thể, option1Value và option2Value đều null. Gửi 2 biến thể trở lên thì lỗi 400. Request này không lưu productId, các request sau vẫn dùng sản phẩm 2 tầng ở trên."
              }
            },
            {
              "name": "Tìm kiếm sản phẩm (phân trang)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/products?keyword=giày&includeDeleted=false&page=0&size=20&sort=id,desc",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "products"
                  ],
                  "query": [
                    {
                      "key": "keyword",
                      "value": "giày"
                    },
                    {
                      "key": "categoryId",
                      "value": "{{categoryId}}",
                      "disabled": true
                    },
                    {
                      "key": "includeDeleted",
                      "value": "false"
                    },
                    {
                      "key": "page",
                      "value": "0"
                    },
                    {
                      "key": "size",
                      "value": "20"
                    },
                    {
                      "key": "sort",
                      "value": "id,desc"
                    }
                  ]
                }
              }
            },
            {
              "name": "Xem chi tiết sản phẩm",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/products/{{productId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "products",
                    "{{productId}}"
                  ]
                }
              }
            },
            {
              "name": "Sửa thông tin sản phẩm",
              "request": {
                "method": "PUT",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/products/{{productId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "products",
                    "{{productId}}"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Giày chạy bộ 2026\",\n  \"description\": \"Đế êm, nhẹ, thoáng khí\",\n  \"categoryId\": {{categoryId}},\n  \"brandId\": {{brandId}},\n  \"variationName1\": \"Màu\",\n  \"variationName2\": \"Size\",\n  \"imageUrls\": [\n    \"https://example.com/giay-1.jpg\",\n    \"https://example.com/giay-2.jpg\"\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Danh sách ảnh gửi lên thay thế toàn bộ ảnh cũ. Đổi được tên các tầng phân loại, nhưng số tầng phải giữ nguyên (gửi ít hoặc nhiều tầng hơn lúc tạo thì lỗi 409). Biến thể sửa ở thư mục Biến thể."
              }
            },
            {
              "name": "Xóa sản phẩm (xóa mềm)",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/products/{{productId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "products",
                    "{{productId}}"
                  ]
                },
                "description": "Trả 204. Sản phẩm chuyển sang ngừng bán, mã SKU được giải phóng. Sau đó sửa sẽ bị 409."
              }
            }
          ]
        },
        {
          "name": "Biến thể",
          "item": [
            {
              "name": "Thêm biến thể",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/products/{{productId}}/variants",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "products",
                    "{{productId}}",
                    "variants"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"option1Value\": \"Trắng\",\n  \"option2Value\": \"43\",\n  \"price\": 890000,\n  \"stock\": 5,\n  \"skuCode\": \"GCB-TRANG-43\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Số giá trị phải khớp số tầng của sản phẩm (2 tầng: cả option1Value và option2Value; 1 tầng: chỉ option1Value). Sản phẩm không có phân loại không thêm được biến thể (409)."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code < 300) { pm.collectionVariables.set('variantId', pm.response.json().id); }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Sửa biến thể",
              "request": {
                "method": "PUT",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/products/{{productId}}/variants/{{variantId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "products",
                    "{{productId}}",
                    "variants",
                    "{{variantId}}"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"option1Value\": \"Trắng\",\n  \"option2Value\": \"43\",\n  \"price\": 850000,\n  \"stock\": 8,\n  \"skuCode\": \"GCB-TRANG-43\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "description": "Gửi đủ mọi trường như khi thêm. Đổi sang tổ hợp giá trị mà biến thể khác đã có thì lỗi 409."
              }
            },
            {
              "name": "Xóa biến thể",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/admin/products/{{productId}}/variants/{{variantId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "admin",
                    "products",
                    "{{productId}}",
                    "variants",
                    "{{variantId}}"
                  ]
                },
                "description": "Không xóa được biến thể cuối cùng (409)."
              }
            }
          ]
        }
      ]
    }
  ]
}