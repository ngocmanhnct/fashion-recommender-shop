# Cổng vào của staging. Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt) cho tên miền
# trong STAGING_DOMAIN, http:// tự chuyển sang https://.
{$STAGING_DOMAIN} {
	encode zstd gzip

	# Header bảo mật cơ bản: luôn dùng HTTPS, không cho trang khác nhúng site vào iframe,
	# trình duyệt không đoán kiểu file, không gửi đường dẫn đầy đủ sang site khác.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API nghiệp vụ, kể cả VNPay gọi /api/payments/vnpay/ipn.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Chỉ mở health của Actuator (trang /health của frontend và job deploy kiểm tra).
	handle /actuator/health {
		reverse_proxy backend:8080
	}

	# Còn lại là trang React.
	handle {
		reverse_proxy frontend:80
	}
}
