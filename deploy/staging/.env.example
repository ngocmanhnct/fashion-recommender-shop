# Mẫu cho file .env TRÊN MÁY ẢO STAGING (~/fashionshop/.env), tạo tay bằng nano, không commit.
# Dùng giá trị khác máy dev. Sinh chuỗi ngẫu nhiên trên máy ảo: openssl rand -base64 36

# Tên miền Azure của máy ảo (Public IP -> Configuration -> DNS name label).
STAGING_DOMAIN=

MYSQL_ROOT_PASSWORD=
# Bắt buộc ở staging (tối thiểu 32 ký tự), để phiên đăng nhập còn hiệu lực sau mỗi lần deploy.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# VNPay sandbox: cùng giá trị với máy dev được. Để trống thì chỉ có COD.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# --- Chức năng 21: email đặt lại mật khẩu (Gmail SMTP) ---
# Bật xác minh 2 bước cho Gmail, rồi tạo "Mật khẩu ứng dụng" (myaccount.google.com/apppasswords):
# MAIL_PASSWORD là 16 ký tự đó, KHÔNG phải mật khẩu Gmail. Để trống MAIL_HOST thì không gửi email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Tên hiện ở ô "Từ", vd: Fashion Shop <ten@gmail.com>. Để trống thì dùng MAIL_USERNAME.
MAIL_FROM=
